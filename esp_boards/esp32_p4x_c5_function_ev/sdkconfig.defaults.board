# ESP32-P4X-C5-Function-EV-Board — ESP32-P4, 16 MB flash, 32 MB HEX PSRAM
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y

CONFIG_CODEC_ES8311_SUPPORT=y
CONFIG_CODEC_ES7210_SUPPORT=n
CONFIG_CODEC_ES7243_SUPPORT=n
CONFIG_CODEC_ES7243E_SUPPORT=n
CONFIG_CODEC_ES8156_SUPPORT=n
CONFIG_CODEC_AW88298_SUPPORT=n
CONFIG_CODEC_ES8389_SUPPORT=n
CONFIG_CODEC_ES8374_SUPPORT=n
CONFIG_CODEC_ES8388_SUPPORT=n
CONFIG_CODEC_TAS5805M_SUPPORT=n
CONFIG_CODEC_ZL38063_SUPPORT=n
CONFIG_CODEC_CJC8910_SUPPORT=n

#
# Camera Sensor Configuration
#
CONFIG_CAMERA_SC2336=y
CONFIG_CAMERA_SC2336_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_SC2336_MIPI_RAW8_1280X720_30FPS=y
CONFIG_CAMERA_SC2336_MIPI_IF_FORMAT_INDEX_DEFAULT=9
CONFIG_CAMERA_SC2336_DVP_RAW10_1280X720_30FPS=y
CONFIG_CAMERA_SC2336_DVP_IF_FORMAT_INDEX_DEFAULT=0
CONFIG_CAMERA_SC2336_ABSOLUTE_GAIN_LIMIT=66016
CONFIG_CAMERA_SC2336_DIG_GAIN_PRIORITY=y
CONFIG_CAMERA_SC2336_DEFAULT_IPA_JSON_CONFIGURATION_FILE=y
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y

#
# Hosted SDIO Configuration — link to the ESP32-C5-MINI-1 companion.
#
# Source: espressif/esp-hosted-mcu Kconfig, board symbol
# ESP_HOSTED_P4X_C5_DEV_BOARD_FUNC_BOARD ("ESP32-P4X-Function-EV-Board with
# on-board C5"). Every pin below is pinned there by a RANGE_MIN/RANGE_MAX
# pair whose min == max for this board, i.e. the value is fixed by the
# layout, not a user choice:
#   CMD 19, CLK 18, D0 14, D1 15, D2 16, D3 17, slave reset 54.
# https://github.com/espressif/esp-hosted-mcu/blob/main/Kconfig
# Cross-checked against the same map printed by the C6-companion board's
# own boot log in esp-hosted-mcu docs/esp32_p4_function_ev_board.md:
#   "GPIOs: CLK[18] CMD[19] D0[14] D1[15] D2[16] D3[17] Slave_Reset[54]".
# GPIO54 is also confirmed board-side by the user guide's J1 footnote:
#   "To enable GPIO54 on the connector, move R76 to R80 to disable the
#    ESP32-P4 control of the ESP32-C5 enable function."
#
# DO NOT "fix" these to 4/33/20/23/21/22 + reset 53. That map is a DIFFERENT
# board in the same Kconfig — ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD with
# CP_TARGET_ESP32C5, i.e. the C6 Function-EV-Board with a C5 bolted on a sub-
# board. ESP_HOSTED_P4_C5_CORE_BOARD (51/50/49/48/53/52) is a third board.
# On THIS board GPIO53 is the PA enable, not a reset.
#
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=19
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=18
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=14
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=15
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=16
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=17
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54