# ESP32-C3-Lyra uses 4 MB flash. This target-specific file is loaded after
# sdkconfig.defaults and overrides its feature-rich 8 MB partition layout.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_test_app_4mb.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_test_app_4mb.csv"

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
